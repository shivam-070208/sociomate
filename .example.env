# Root env examples for the repository

# API Server
PORT=3000
APP_NAME="api-server"
APP_VERSION="1.0.0"
DEBUG=false
JWT_SECRET="your-jwt-secret"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sociomate"
DATABASE_URL_READ_REPLICA="postgresql://user:password@localhost:5433/sociomate"

# RabbitMQ / queue package
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_EXCHANGE="sociomate.exchange"
RABBITMQ_EXCHANGE_TYPE="direct"
RABBITMQ_QUEUE="sociomate.queue"
RABBITMQ_OTP_ROUTING_KEY="otp.send"
